{% extends "base.html" %}

{% block title %}
{{ page_title }}
{% endblock %}

{% block head %}

<meta
    name="description"
    content="{{ page_description }}"
>

<meta
    name="robots"
    content="index, follow"
>

<meta
    property="og:type"
    content="article"
>

<meta
    property="og:title"
    content="{{ page_title }}"
>

<meta
    property="og:description"
    content="{{ page_description }}"
>

<meta
    property="og:url"
    content="{{ request.url }}"
>

<link
    rel="canonical"
    href="{{ request.url }}"
>

<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "SportsEvent",
    "name": {{ (match.home_team ~ " vs " ~ match.away_team)|tojson }},
    "sport": "Football",
    "url": {{ request.url|tojson }},
    "startDate": {{ match.kickoff_time.isoformat()|tojson }},
    "homeTeam": {
        "@type": "SportsTeam",
        "name": {{ match.home_team|tojson }}
    },
    "awayTeam": {
        "@type": "SportsTeam",
        "name": {{ match.away_team|tojson }}
    },
    "description": {{ page_description|tojson }}
}
</script>

<style>
    .pp-match-page {
        width: min(100%, 1000px);
        margin: 0 auto;
        padding: 24px 14px 60px;
    }

    .pp-match-breadcrumb {
        margin-bottom: 18px;
        color: #6c757d;
        font-size: .82rem;
    }

    .pp-match-breadcrumb a {
        color: #198754;
        font-weight: 800;
        text-decoration: none;
    }

    .pp-match-card {
        overflow: hidden;
        border: 1px solid #e2e8e4;
        border-radius: 18px;
        background: #ffffff;
        box-shadow: 0 8px 24px rgba(23, 32, 27, .06);
    }

    .pp-match-header {
        padding: 24px 18px;
        background: #f7faf8;
        border-bottom: 1px solid #e2e8e4;
        text-align: center;
    }

    .pp-match-league {
        margin-bottom: 7px;
        color: #198754;
        font-size: .75rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .07em;
    }

    .pp-match-title {
        margin: 0;
        color: #17201b;
        font-size: clamp(1.55rem, 7vw, 2.5rem);
        font-weight: 900;
        line-height: 1.1;
        letter-spacing: -.035em;
    }

    .pp-match-date {
        margin-top: 10px;
        color: #6c757d;
        font-size: .9rem;
    }

    .pp-match-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-top: 13px;
        min-height: 34px;
        padding: 6px 12px;
        border-radius: 999px;
        background: #eaf6ef;
        color: #146c43;
        font-size: .72rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .pp-match-body {
        padding: 20px 18px;
    }

    .pp-match-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .pp-match-stat {
        padding: 14px;
        border: 1px solid #e2e8e4;
        border-radius: 12px;
        background: #ffffff;
    }

    .pp-match-label {
        display: block;
        margin-bottom: 4px;
        color: #6c757d;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .pp-match-value {
        color: #17201b;
        font-size: 1rem;
        font-weight: 850;
        overflow-wrap: anywhere;
    }

    .pp-match-score {
        margin: 22px 0;
        padding: 20px;
        border-radius: 14px;
        background: #17201b;
        color: #ffffff;
        text-align: center;
    }

    .pp-match-score-label {
        display: block;
        margin-bottom: 5px;
        color: #b8c5bd;
        font-size: .72rem;
        font-weight: 800;
        text-transform: uppercase;
    }

    .pp-match-score-value {
        font-size: clamp(2rem, 10vw, 3rem);
        font-weight: 900;
        line-height: 1;
    }

    .pp-match-analysis {
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e2e8e4;
    }

    .pp-match-analysis h2 {
        margin: 0 0 8px;
        color: #17201b;
        font-size: 1.1rem;
        font-weight: 900;
    }

    .pp-match-analysis p {
        margin: 0;
        color: #59635d;
        line-height: 1.65;
    }

    .pp-match-back {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-top: 18px;
        color: #198754;
        font-weight: 850;
        text-decoration: none;
    }

    @media (min-width: 576px) {
        .pp-match-page {
            padding-inline: 20px;
        }

        .pp-match-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pp-match-body {
            padding: 28px;
        }
    }
</style>

{% endblock %}

{% block content %}

<main class="pp-match-page">

    <div class="pp-match-breadcrumb">
        <a href="{{ url_for('main.index') }}">PinnaclePicks</a>
        <span aria-hidden="true"> / </span>
        <a href="{{ url_for('main.previous_results') }}">
            Match History
        </a>
        <span aria-hidden="true"> / </span>
        <span>{{ match.home_team }} vs {{ match.away_team }}</span>
    </div>

    <article class="pp-match-card">

        <header class="pp-match-header">

            <div class="pp-match-league">
                {{ match.league }}
            </div>

            <h1 class="pp-match-title">
                {{ match.home_team }}
                vs
                {{ match.away_team }}
            </h1>

            <div class="pp-match-date">
                {{ match.kickoff_time.strftime("%A, %d %B %Y at %H:%M") }}
            </div>

            <div class="pp-match-status">
                {{ match.status|capitalize }}
            </div>

        </header>

        <div class="pp-match-body">

            {% if match.status in ["finished", "void"] %}

            <div class="pp-match-score">

                <span class="pp-match-score-label">
                    Final Score
                </span>

                <div class="pp-match-score-value">
                    {{ match.score_display }}
                </div>

            </div>

            {% endif %}

            <div class="pp-match-grid">

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Home Team
                    </span>

                    <div class="pp-match-value">
                        {{ match.home_team }}
                    </div>
                </div>

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Away Team
                    </span>

                    <div class="pp-match-value">
                        {{ match.away_team }}
                    </div>
                </div>

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Competition
                    </span>

                    <div class="pp-match-value">
                        {{ match.league }}
                    </div>
                </div>

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Market
                    </span>

                    <div class="pp-match-value">
                        {{ match.market_label }}
                    </div>
                </div>

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        PinnaclePicks Selection
                    </span>

                    <div class="pp-match-value">
                        {{ match.pick_selection }}
                    </div>
                </div>

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Odds
                    </span>

                    <div class="pp-match-value">
                        {{ match.odds }}
                    </div>
                </div>

                {% if match.status == "finished" %}

                <div class="pp-match-stat">
                    <span class="pp-match-label">
                        Prediction Outcome
                    </span>

                    <div class="pp-match-value">
                        {{ match.result_label }}
                    </div>
                </div>

                {% endif %}

            </div>

            <section class="pp-match-analysis">

                <h2>
                    {{ match.home_team }} vs {{ match.away_team }} —
                    PinnaclePicks Match Analysis
                </h2>

                <p>
                    This PinnaclePicks match record contains the competition,
                    scheduled kickoff, prediction market, selected outcome,
                    odds and match result information. Completed matches
                    remain available in the PinnaclePicks historical archive
                    for reference and statistical analysis.
                </p>

            </section>

            <a
                class="pp-match-back"
                href="{{ url_for('main.previous_results') }}"
            >
                ← Browse PinnaclePicks Match History
            </a>

        </div>

    </article>

</main>

{% endblock %}
