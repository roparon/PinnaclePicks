{% extends "base.html" %}

{% block title %}
Match History | PinnaclePicks
{% endblock %}

{% block head %}
<meta
    name="description"
    content="Browse the PinnaclePicks historical match archive, including concluded matches, final scores and prediction results."
>

<style>

    .pp-history-page {
        width: min(100%, 1180px);
        margin: 0 auto;
        padding: 20px 12px 56px;
    }

    .pp-history-header {
        margin-bottom: 20px;
    }

    .pp-history-back {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        margin-bottom: 12px;
        color: #6c757d;
        text-decoration: none;
        font-weight: 800;
    }

    .pp-history-back:hover {
        color: #198754;
    }

    .pp-history-eyebrow {
        margin: 0 0 5px;
        color: #198754;
        font-size: .75rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .09em;
    }

    .pp-history-title {
        margin: 0;
        color: #17201b;
        font-size: clamp(1.7rem, 7vw, 2.5rem);
        font-weight: 900;
        line-height: 1.08;
        letter-spacing: -.035em;
    }

    .pp-history-subtitle {
        max-width: 720px;
        margin: 9px 0 0;
        color: #6c757d;
        line-height: 1.55;
    }

    .pp-history-summary {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
        margin-bottom: 18px;
    }

    .pp-history-stat {
        padding: 15px;
        border: 1px solid #e2e8e4;
        border-radius: 12px;
        background: #ffffff;
    }

    .pp-history-stat-label {
        display: block;
        margin-bottom: 3px;
        color: #6c757d;
        font-size: .74rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .pp-history-stat-value {
        display: block;
        color: #17201b;
        font-size: 1.25rem;
        font-weight: 900;
    }

    .pp-history-card {
        overflow: hidden;
        border: 1px solid #e2e8e4;
        border-radius: 16px;
        background: #ffffff;
    }

    .pp-history-card-header {
        padding: 16px;
        border-bottom: 1px solid #e2e8e4;
    }

    .pp-history-card-title {
        margin: 0;
        color: #17201b;
        font-size: 1rem;
        font-weight: 900;
    }

    .pp-history-card-description {
        margin: 5px 0 0;
        color: #6c757d;
        font-size: .82rem;
        line-height: 1.45;
    }

    .pp-history-list {
        padding: 0 16px;
    }

    .pp-history-item {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 15px 0;
        border-bottom: 1px solid #edf1ee;
    }

    .pp-history-item:last-child {
        border-bottom: 0;
    }

    .pp-history-league {
        margin-bottom: 4px;
        color: #6c757d;
        font-size: .73rem;
        font-weight: 750;
        line-height: 1.35;
    }

    .pp-history-teams {
        color: #17201b;
        font-size: .92rem;
        font-weight: 850;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .pp-history-vs {
        color: #8a948e;
        font-weight: 600;
    }

    .pp-history-score {
        margin-top: 4px;
        color: #17201b;
        font-size: 1rem;
        font-weight: 900;
    }

    .pp-history-result {
        min-width: 58px;
        min-height: 32px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 9px;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .pp-history-result-won {
        background: #eaf6ef;
        color: #146c43;
    }

    .pp-history-result-lost {
        background: #fff0f0;
        color: #b42318;
    }

    .pp-history-result-void {
        background: #f1f3f2;
        color: #59635d;
    }

    .pp-history-result-pending {
        background: #fff8e6;
        color: #8a6500;
    }

    .pp-history-empty {
        padding: 40px 18px;
        color: #6c757d;
        text-align: center;
        line-height: 1.5;
    }

    .pp-history-pagination {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 20px;
    }

    .pp-history-page-link {
        min-width: 44px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border: 1px solid #dfe7e2;
        border-radius: 10px;
        background: #ffffff;
        color: #17201b;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 850;
    }

    .pp-history-page-link:hover {
        border-color: #198754;
        color: #198754;
    }

    .pp-history-page-link-active {
        border-color: #198754;
        background: #198754;
        color: #ffffff;
    }

    .pp-history-page-link-active:hover {
        color: #ffffff;
    }

    .pp-history-page-link-disabled {
        opacity: .45;
        pointer-events: none;
    }

    .pp-history-page-info {
        width: 100%;
        margin-top: 4px;
        color: #6c757d;
        font-size: .76rem;
        text-align: center;
    }

    @media (min-width: 576px) {

        .pp-history-page {
            padding: 30px 20px 64px;
        }

        .pp-history-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pp-history-card-header {
            padding: 20px;
        }

        .pp-history-list {
            padding-inline: 20px;
        }

        .pp-history-item {
            padding: 17px 0;
        }

        .pp-history-page-info {
            width: auto;
            margin-top: 0;
            margin-inline: 8px;
        }

    }

    @media (min-width: 900px) {

        .pp-history-summary {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .pp-history-item {
            grid-template-columns: minmax(0, 1fr) auto;
        }

    }

</style>
{% endblock %}


{% block content %}

<main class="pp-history-page">

    <header class="pp-history-header">

        <a
            href="{{ url_for('main.index') }}#history"
            class="pp-history-back"
        >
            ← Back to Match History
        </a>

        <p class="pp-history-eyebrow">
            PinnaclePicks Archive
        </p>

        <h1 class="pp-history-title">
            Historical Match Archive
        </h1>

        <p class="pp-history-subtitle">
            Browse concluded matches across previous weeks and months,
            with final scores and recorded prediction results.
        </p>

    </header>


    <section
        class="pp-history-summary"
        aria-label="Archive summary"
    >

        <div class="pp-history-stat">

            <span class="pp-history-stat-label">
                Archived Matches
            </span>

            <span class="pp-history-stat-value">
                {{ archive.total }}
            </span>

        </div>


        <div class="pp-history-stat">

            <span class="pp-history-stat-label">
                Current Page
            </span>

            <span class="pp-history-stat-value">
                {{ archive.page }}
            </span>

        </div>


        <div class="pp-history-stat">

            <span class="pp-history-stat-label">
                Total Pages
            </span>

            <span class="pp-history-stat-value">
                {{ archive.pages }}
            </span>

        </div>

    </section>


    <section class="pp-history-card">

        <header class="pp-history-card-header">

            <h2 class="pp-history-card-title">
                Concluded Matches
            </h2>

            <p class="pp-history-card-description">
                Showing up to {{ archive.per_page }} matches per page.
            </p>

        </header>


        {% if historical_matches %}

            <div class="pp-history-list">

                {% for match in historical_matches %}

                    <article class="pp-history-item">

                        <div>

                            <div class="pp-history-league">
                                {{ match.league }}
                                ·
                                {{ match.kickoff_time.strftime('%d %b %Y') }}
                            </div>

                            <div class="pp-history-teams">

                                <a
                                    href="{{ url_for('seo.match_detail', match_id=match.id) }}"
                                    style="color: inherit; text-decoration: none;"
                                >
                                    {{ match.home_team }}

                                    <span class="pp-history-vs">
                                        vs
                                    </span>

                                    {{ match.away_team }}
                                </a>

                            </div>

                            <div class="pp-history-score">
                                Final Score: {{ match.score_display }}
                            </div>

                        </div>


                        <div>

                            {% if match.status == 'void' %}

                                <span
                                    class="pp-history-result pp-history-result-void"
                                >
                                    Void
                                </span>

                            {% elif match.is_win is true %}

                                <span
                                    class="pp-history-result pp-history-result-won"
                                >
                                    Won
                                </span>

                            {% elif match.is_win is false %}

                                <span
                                    class="pp-history-result pp-history-result-lost"
                                >
                                    Lost
                                </span>

                            {% else %}

                                <span
                                    class="pp-history-result pp-history-result-pending"
                                >
                                    Pending
                                </span>

                            {% endif %}

                        </div>

                    </article>

                {% endfor %}

            </div>

        {% else %}

            <div class="pp-history-empty">
                No concluded matches have been recorded yet.
            </div>

        {% endif %}

    </section>


    {% if archive.pages > 1 %}

        <nav
            class="pp-history-pagination"
            aria-label="Match history pagination"
        >

            {% if archive.has_prev %}

                <a
                    href="{{ url_for('main.previous_results', page=archive.page - 1, per_page=archive.per_page) }}"
                    class="pp-history-page-link"
                    aria-label="Previous page"
                >
                    ←
                </a>

            {% else %}

                <span
                    class="pp-history-page-link pp-history-page-link-disabled"
                    aria-hidden="true"
                >
                    ←
                </span>

            {% endif %}


            {% set start_page = [1, archive.page - 2]|max %}
            {% set end_page = [archive.pages, archive.page + 2]|min %}

            {% if start_page > 1 %}

                <a
                    href="{{ url_for('main.previous_results', page=1, per_page=archive.per_page) }}"
                    class="pp-history-page-link"
                >
                    1
                </a>

                {% if start_page > 2 %}
                    <span class="pp-history-page-link pp-history-page-link-disabled">
                        …
                    </span>
                {% endif %}

            {% endif %}


            {% for page_number in range(start_page, end_page + 1) %}

                {% if page_number == archive.page %}

                    <span
                        class="pp-history-page-link pp-history-page-link-active"
                        aria-current="page"
                    >
                        {{ page_number }}
                    </span>

                {% else %}

                    <a
                        href="{{ url_for('main.previous_results', page=page_number, per_page=archive.per_page) }}"
                        class="pp-history-page-link"
                    >
                        {{ page_number }}
                    </a>

                {% endif %}

            {% endfor %}


            {% if end_page < archive.pages %}

                {% if end_page < archive.pages - 1 %}
                    <span class="pp-history-page-link pp-history-page-link-disabled">
                        …
                    </span>
                {% endif %}

                <a
                    href="{{ url_for('main.previous_results', page=archive.pages, per_page=archive.per_page) }}"
                    class="pp-history-page-link"
                >
                    {{ archive.pages }}
                </a>

            {% endif %}


            {% if archive.has_next %}

                <a
                    href="{{ url_for('main.previous_results', page=archive.page + 1, per_page=archive.per_page) }}"
                    class="pp-history-page-link"
                    aria-label="Next page"
                >
                    →
                </a>

            {% else %}

                <span
                    class="pp-history-page-link pp-history-page-link-disabled"
                    aria-hidden="true"
                >
                    →
                </span>

            {% endif %}


            <span class="pp-history-page-info">
                Page {{ archive.page }} of {{ archive.pages }}
            </span>

        </nav>

    {% endif %}

</main>

{% endblock %}
